    line-height: 1.2;
  }

  .search-clear {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
  }

  .search-results {
    margin-top: 18px;
  }

  .search-result-count {
    margin-bottom: 5px;
    font-size: 8px;
  }

  .search-results > a {
    grid-template-columns: 62px minmax(0, 1fr) auto;
    gap: 11px;
    min-height: 82px;
    padding: 10px 0;
  }

  .search-results > a > span,
  .search-results img,
