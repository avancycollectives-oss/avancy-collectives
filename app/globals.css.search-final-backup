    gap: 8px;
    margin-top: 22px;
  }

  .search-shortcuts > a {
    min-height: 52px;
    display: grid;
    grid-template-columns: 30px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border: 1px solid #bbb;
    border-radius: 12px;
    background: #fff;
    color: #111;
  }

  .search-shortcuts > a > span {
    font-size: 8px;
    color: #777;
  }

  .search-shortcuts > a > b {
    font-size: 18px;
  }

  .search-shortcuts > a:active {
    transform: scale(.985);
  }
}

@keyframes avMobileSearchUp {
  from {
    opacity: 0;
    transform: translateY(35px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


