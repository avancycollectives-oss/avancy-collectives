/* =========================================================
   AVANCY MOBILE SEARCH UX
   Added without changing existing desktop search styles.
   ========================================================= */

body.search-open {
  overflow: hidden;
}

.search-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input-wrap > svg {
  width: 21px;
  height: 21px;
  flex: 0 0 21px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  margin-right: 12px;
}

.search-input-wrap input {
  flex: 1;
  min-width: 0;
}

.search-clear {
  border: 0;
  background: transparent;
  color: #111;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  font-size: 24px;
  cursor: pointer;
}

.search-head > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.search-head > div > span {
  color: #777;
  font-size: 8px;
  letter-spacing: .16em;
}

.search-head > div > b {
  font-size: 13px;
}

.search-result-count {
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .16em;
  color: #777;
  margin-bottom: 8px;
}

.search-empty {
  padding: 35px 0;
  border-bottom: 1px solid #ccc;
}

.search-empty > span {
  display: block;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .14em;
}

.search-empty p {
  margin: 8px 0 0;
  color: #777;
  font-size: 11px;
  line-height: 1.5;
  max-width: 420px;
}

.search-no-results {
  padding: 35px 0;
  border-bottom: 1px solid #ccc;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.search-no-results b {
  font-size: 10px;
}

.search-no-results span {
  color: #777;
  font-size: 10px;
}

@media (max-width: 700px) {

  .search-overlay {
    align-items: flex-end;
    justify-content: center;
    background: rgba(0, 0, 0, .72);
    padding: 0;
  }

  .search-panel {
    width: 100%;
    max-width: none;
    height: min(92dvh, 760px);
    border-radius: 24px 24px 0 0;
    padding: 22px 18px max(22px, env(safe-area-inset-bottom));
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    box-shadow: 0 -20px 70px rgba(0, 0, 0, .35);
    animation: avMobileSearchUp .28s cubic-bezier(.22,.8,.25,1) both;
  }

  .search-head {
    align-items: center;
    margin-bottom: 18px;
  }

  .search-head > div > span {
    font-size: 7px;
  }

  .search-head > div > b {
    font-size: 15px;
  }

  .search-head button {
    width: 44px;
    height: 44px;
    min-width: 44px;
    border-radius: 12px;
    font-size: 26px;
    display: grid;
    place-items: center;
  }

  .search-input-wrap {
    min-height: 58px;
    border: 1px solid #aaa;
    border-radius: 14px;
    padding: 0 12px;
